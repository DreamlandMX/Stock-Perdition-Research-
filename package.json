{
  "name": "stock-prediction-tooling",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "minimatch": "11.0.5"
  },
  "scripts": {
    "contracts:export": "powershell -ExecutionPolicy Bypass -File scripts/export-openapi.ps1",
    "contracts:generate": "powershell -ExecutionPolicy Bypass -File scripts/generate-api-types.ps1",
    "contracts:check": "powershell -ExecutionPolicy Bypass -File scripts/generate-api-types.ps1 -Check",
    "docs:check": "powershell -ExecutionPolicy Bypass -File scripts/check-markdown-links.ps1",
    "dev": "vite --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project frontend/tsconfig.json && tsc --noEmit --project frontend/e2e/tsconfig.json",
    "lint": "eslint tooling/typescript frontend vitest.config.ts playwright.config.ts --max-warnings=0",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:update": "playwright test --config playwright.config.ts --update-snapshots"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.7.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.3.6",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-table": "8.21.3",
    "echarts": "6.1.0",
    "lightweight-charts": "5.2.0",
    "lucide-react": "1.24.0",
    "openapi-fetch": "0.17.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.5"
  }
}
